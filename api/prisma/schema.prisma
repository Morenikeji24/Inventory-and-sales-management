// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  MANAGER
  ADMIN
}

model Staff {
  id         Int         @id @default(autoincrement())
  firstName  String
  middleName String
  lastName   String
  email      String      @unique
  phone      Int         @unique
  password   String
  role       Role        @default(ADMIN)
  createdAt  DateTime    @default(now())
  customers  Customers[]
}

model Customers {
  id               Int      @id @default(autoincrement())
  firstName        String
  middleName       String
  lastName         String
  email            String   @unique
  phone            Int      @unique
  password         String
  birthDate        DateTime
  registrationDate DateTime
  createdBy        Int
  staff            Staff    @relation(fields: [createdBy], references: [id])
}

model Product {
  id          Int    @id @default(autoincrement())
  name        String
  description String
  producer    String
  price       Int
}
